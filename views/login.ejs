<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Login - Waver</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .login-box {
            width: 350px;
            margin: 80px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .login-box h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .login-box input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .login-box button {
            width: 100%;
            padding: 12px;
            background: black;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        .login-box button:hover {
            background: #333;
        }
    <!--barber-->
    .barber-btn{
    display:block;
    width:100%;
    text-align:center;
    padding:12px;
    background:#28a745;
    color:white;
    text-decoration:none;
    border-radius:8px;
    margin-top:15px;
    font-weight:bold;
}

.barber-btn:hover{
    background:#1f8a38;
}
    </style>
</head>

<body>
<div class="logo-container">
    <img src="/images/logo.png" alt="Waver Logo" class="logo">
</div>
    <!-- NAVBAR -->
    <nav>
        <img src="/images/waver.png" alt="Waver Logo" class="logo">

        <ul>
            <li><a href="/">Home</a></li>
            <li>Services</li>
            <li><a href="/login">Login</a></li>
        </ul>
    </nav>

    <!-- LOGIN BOX -->
    <div class="login-box">
        <h1>Login with Email OTP</h1>

        <!-- EMAIL INPUT -->
        <input type="email" id="email" placeholder="Enter Email">

        <button onclick="sendOTP()">Send OTP</button>

        <!-- OTP INPUT -->
        <input type="text" id="otp" placeholder="Enter OTP">

        <button onclick="verifyOTP()">Verify OTP</button>
        <hr style="margin:20px 0;">

<a href="/barber-login" class="barber-btn">
    ✂ Barber Login
</a>
    </div>

    <!-- EMAIL OTP SCRIPT -->
    <script>
        // SEND OTP
        async function sendOTP() {
            let email = document.getElementById("email").value;

            if (!email) {
                alert("Please enter email");
                return;
            }

            await fetch("/send-email-otp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email })
            });

            alert("OTP Sent to Email 📩");
        }

        // VERIFY OTP
        async function verifyOTP() {
            let otp = document.getElementById("otp").value;

            if (!otp) {
                alert("Please enter OTP");
                return;
            }

            let res = await fetch("/verify-email-otp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ otp })
            });

            let data = await res.json();

            

            if (data.success) {
                window.location.href = data.redirect;} else{
                    alert("invalid otp");
            }
        }
    </script>
<!-- WhatsApp Floating Button -->
