<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Login - Waver</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .login-box {
            width: 350px;
            margin: 80px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .login-box h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .login-box input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .login-box button {
            width: 100%;
            padding: 12px;
            background: black;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        .login-box button:hover {
            background: #333;
        }
    </style>
</head>

<body>

    <!-- SAME NAVBAR -->
    <nav>
        <h2>Waver</h2>

        <ul>
            <li><a href="/">Home</a></li>
            <li>Services</li>
            <li><a href="/login">Login</a></li>
        </ul>
    </nav>

    <!-- LOGIN SECTION -->
    <div class="login-box">
        <h1>Login</h1>

        <form action="/login" method="POST">
            <input type="text" name="username" placeholder="Username" required>
            <input type="password" name="password" placeholder="Password" required>
            <button type="submit">Login</button>
        </form>
    </div>

</body>

</html>