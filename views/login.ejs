<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Login - Waver</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .login-box {
            width: 350px;
            margin: 80px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .login-box h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .login-box input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .login-box button {
            width: 100%;
            padding: 12px;
            background: black;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        .login-box button:hover {
            background: #333;
        }
    <!--barber-->
    .barber-btn{
    display:block;
    width:100%;
    text-align:center;
    padding:12px;
    background:#28a745;
    color:white;
    text-decoration:none;
    border-radius:8px;
    margin-top:15px;
    font-weight:bold;
}

.barber-btn:hover{
    background:#1f8a38;
}
.admin-btn{
    display:block;
    width:100%;
    text-align:center;
    padding:12px;
    background:#0d6efd;
    color:white;
    text-decoration:none;
    border-radius:8px;
    margin-top:10px;
    font-weight:bold;
}

.admin-btn:hover{
    background:#0b5ed7;
}
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav>
        <img src="/images/waver.png" alt="Waver Logo" class="logo">

        <ul>
            <li><a href="/">Home</a></li>
            <li>Services</li>
            <li><a href="/login">Login</a></li>
        </ul>
    </nav>

    <!-- LOGIN BOX -->
    <div class="login-box">
        <h1>Login with Email OTP</h1>
<button id="googleLogin" onclick="window.location='/auth/google'">
    Continue with Google
</button>

<p style="text-align:center;margin:15px 0;font-weight:bold;">
    OR
</p>
        <!-- EMAIL INPUT -->
        <input type="email" id="email" placeholder="Enter Email">

        <button onclick="sendOTP()">Send OTP</button>

        <!-- OTP INPUT -->
        <input type="text" id="otp" placeholder="Enter OTP">

        <button onclick="verifyOTP()">Verify OTP</button>
        <hr style="margin:20px 0;">

<a href="/barber-login" class="barber-btn">
    ✂ Barber Login
</a>
<a href="/admin-login" class="admin-btn">
    🛡️ Admin Login
</a>
    </div>

    
<script type="module">

import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
    "https://jnupyibeedhzwdqcxtnf.supabase.co",
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpudXB5aWJlZWRoendkcWN4dG5mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMwNTQxODcsImV4cCI6MjA5ODYzMDE4N30.LudlDiybkPGtGc5XAAcKiQ_ZRmE1Gj3TFzM3kg4pHew"
);


// SEND OTP

window.sendOTP = async function () {

    const email = document.getElementById("email").value.trim();

    if (!email) {
        alert("Please enter email");
        return;
    }

    const { error } = await supabase.auth.signInWithOtp({
        email: email
    });

    if (error) {

        console.log(error);
        alert(error.message);
        return;

    }

    alert("OTP Sent to Email 📩");

};


// VERIFY OTP

window.verifyOTP = async function () {

    const email = document.getElementById("email").value.trim();
    const otp = document.getElementById("otp").value.trim();

    if (!email || !otp) {

        alert("Enter email and OTP");
        return;

    }

    const { data, error } = await supabase.auth.verifyOtp({

        email: email,
        token: otp,
        type: "email"

    });

    if (error) {

        console.log(error);
        alert("Invalid OTP");
        return;

    }

    console.log("Logged in user:", data.user);
    console.log("Session:", data.session);

    // Save token
    localStorage.setItem(
        "access_token",
        data.session.access_token
    );

    // Go to service
    window.location.href = "/service";

};

</script>





