<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Login - Waver</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .login-box {
            width: 350px;
            margin: 80px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .login-box h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .login-box input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .login-box button {
            width: 100%;
            padding: 12px;
            background: black;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        .login-box button:hover {
            background: #333;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav>
        <h2>Waver</h2>

        <ul>
            <li><a href="/">Home</a></li>
            <li>Services</li>
            <li><a href="/login">Login</a></li>
        </ul>
    </nav>

    <!-- LOGIN BOX -->
    <div class="login-box">
        <h1>Login with OTP</h1>

        <!-- PHONE INPUT -->
        <input type="text" id="phone" placeholder="+91XXXXXXXXXX">

        <button onclick="sendOTP()">Send OTP</button>

        <!-- OTP INPUT -->
        <input type="text" id="otp" placeholder="Enter OTP">

        <button onclick="verifyOTP()">Verify OTP</button>

        <!-- Recaptcha -->
        <div id="recaptcha-container"></div>
    </div>

    <!-- FIREBASE OTP SCRIPT -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";
        import { getAuth, signInWithPhoneNumber, RecaptchaVerifier } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-auth.js";

        // 🔥 YOUR FIREBASE CONFIG (fill this)
        const firebaseConfig = {
            apiKey: "AIzaSyCwW5b1ZDxX8Dr-D60ZtwXwVaqJe_XJRTU",
            authDomain: "onlineattendence-b2a61.firebaseapp.com",
            projectId: "onlineattendence-b2a61",
            appId: "1:954168844446:web:be6a365a8e15c2a85cdb8f",
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);

        // Recaptcha
        window.recaptchaVerifier = new RecaptchaVerifier(auth, "recaptcha-container", {
            size: "normal"
        });

        let confirmationResult;

        // STEP 6: SEND OTP
        window.sendOTP = async () => {
            const phone = document.getElementById("phone").value;

            confirmationResult = await signInWithPhoneNumber(
                auth,
                phone,
                window.recaptchaVerifier
            );

            alert("OTP Sent 📲");
        };

        // STEP 7: VERIFY OTP
        window.verifyOTP = async () => {
            const code = document.getElementById("otp").value;

            await confirmationResult.confirm(code);

            alert("Login Successful 🎉");

            window.location.href = "/";
        };
    </script>

</body>

</html>