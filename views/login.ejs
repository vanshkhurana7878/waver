   target="_blank"
   style="position:fixed;bottom:20px;right:20px;z-index:9999;">
    <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg"
         alt="WhatsApp"
         width="60"
         height="60">
         <a href="/service">
</a>
</body>

</html>