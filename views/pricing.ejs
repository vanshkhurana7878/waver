<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Pricing | Waver</title>
<link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            margin: 0;
            background: #000;
            color: white;
            font-family: Arial, sans-serif;
        }

        nav {
            padding: 20px 40px;
            border-bottom: 1px solid #333;
        }

        h1 {
            text-align: center;
            margin: 30px 0;
        }

        .container {
            width: 90%;
            margin: auto;
        }

        .card {
            background: #111;
            padding: 15px;
            margin: 10px 0;
            border-radius: 10px;
            border: 1px solid #333;
        }

        label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }

        .bottom {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: #111;
            padding: 15px;
            border-top: 1px solid #333;
        }

        button {
            width: 100%;
            padding: 12px;
            background: white;
            border: none;
            font-weight: bold;
            margin-top: 10px;
            cursor: pointer;
        }

        .cash {
            text-align: center;
            color: #aaa;
            margin-top: 5px;
        }
    </style>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>

<body>

<nav>
      <img src="/images/waver.png" alt="Waver Logo" class="logo">
</nav>

<h1>Select Services</h1>

<div class="container">

    <!-- SERVICES -->
    <% if (barber.service_name && barber.price) { %>

        <div class="card">
            <label>
                <span>
                    <input type="checkbox" class="service" data-price="<%= barber.price %>">
                    <%= barber.service_name %>
                </span>

                <b>₹ <%= barber.price %></b>
            </label>
        </div>

    <% } else { %>

        <p>No services found</p>

    <% } %>

</div>

<!-- BOTTOM BAR -->
<div class="bottom">



<!-- ================= TIME SLOT SECTION ================= -->

<div class="slot-section">

    <h2>Select Date</h2>

    <input type="date" id="bookingDate">


    <h2 class="slot-title">Select Time</h2>

    <div class="time-slots" id="timeSlots">

        <button type="button" class="time-slot">9:00 AM</button>
        <button type="button" class="time-slot">9:15 AM</button>
        <button type="button" class="time-slot">9:30 AM</button>
        <button type="button" class="time-slot">9:45 AM</button>

        <button type="button" class="time-slot">10:00 AM</button>
        <button type="button" class="time-slot">10:15 AM</button>
        <button type="button" class="time-slot">10:30 AM</button>
        <button type="button" class="time-slot">10:45 AM</button>

        <button type="button" class="time-slot">11:00 AM</button>
        <button type="button" class="time-slot">11:15 AM</button>
        <button type="button" class="time-slot">11:30 AM</button>
        <button type="button" class="time-slot">11:45 AM</button>

        <button type="button" class="time-slot">12:00 PM</button>
        <button type="button" class="time-slot">12:15 PM</button>
        <button type="button" class="time-slot">12:30 PM</button>
        <button type="button" class="time-slot">12:45 PM</button>

        <button type="button" class="time-slot">1:00 PM</button>
        <button type="button" class="time-slot">1:15 PM</button>
        <button type="button" class="time-slot">1:30 PM</button>
        <button type="button" class="time-slot">1:45 PM</button>

        <button type="button" class="time-slot">2:00 PM</button>
        <button type="button" class="time-slot">2:15 PM</button>
        <button type="button" class="time-slot">2:30 PM</button>
        <button type="button" class="time-slot">2:45 PM</button>

        <button type="button" class="time-slot">3:00 PM</button>
        <button type="button" class="time-slot">3:15 PM</button>
        <button type="button" class="time-slot">3:30 PM</button>
        <button type="button" class="time-slot">3:45 PM</button>

        <button type="button" class="time-slot">4:00 PM</button>
        <button type="button" class="time-slot">4:15 PM</button>
        <button type="button" class="time-slot">4:30 PM</button>
        <button type="button" class="time-slot">4:45 PM</button>

        <button type="button" class="time-slot">5:00 PM</button>
        <button type="button" class="time-slot">5:15 PM</button>
        <button type="button" class="time-slot">5:30 PM</button>
        <button type="button" class="time-slot">5:45 PM</button>

        <button type="button" class="time-slot">6:00 PM</button>
        <button type="button" class="time-slot">6:15 PM</button>
        <button type="button" class="time-slot">6:30 PM</button>
        <button type="button" class="time-slot">6:45 PM</button>

        <button type="button" class="time-slot">7:00 PM</button>
        <button type="button" class="time-slot">7:15 PM</button>
        <button type="button" class="time-slot">7:30 PM</button>
        <button type="button" class="time-slot">7:45 PM</button>

        <button type="button" class="time-slot">8:00 PM</button>
        <button type="button" class="time-slot">8:15 PM</button>
        <button type="button" class="time-slot">8:30 PM</button>
        <button type="button" class="time-slot">8:45 PM</button>

    </div>

    <p id="selectedTime">
        No time selected
    </p>

</div>





    <h3>Total: ₹<span id="total">0</span></h3>

    
    <button type="button" onclick="bookNow()">
    Book Now
</button>

    <div class="cash">
    <label>
        <input type="radio" name="payment" value="cash" checked>
        Cash on Shop
    </label>

    <br>

    <label>
        <input type="radio" name="payment" value="online">
        Pay Online (Razorpay)
    </label>
</div>

</div>

<script>
let checkboxes = document.querySelectorAll(".service");
let totalEl = document.getElementById("total");

checkboxes.forEach(cb => {
    cb.addEventListener("change", updateTotal);
});

function updateTotal() {
    let total = 0;

    checkboxes.forEach(cb => {
        if (cb.checked) {
            total += Number(cb.dataset.price);
        }
    });

    totalEl.innerText = total;
}

async function bookNow() {

    let total = 0;

    checkboxes.forEach(cb => {
        if (cb.checked) {
            total += Number(cb.dataset.price);
        }
    });

    if (total === 0) {
        alert("Please select a service");
        return;
    }

    const payment = document.querySelector('input[name="payment"]:checked').value;

    // Cash
    if (payment === "cash") {

    const res = await fetch("/create-booking",{
    method:"POST",
    headers:{
        "Content-Type":"application/json",
        "Authorization":"Bearer " + localStorage.getItem("access_token")
    },
    
        body:JSON.stringify({
            barber_id:"<%= barber.id %>",
            services: JSON.stringify(["<%= barber.service_name %>"]),
            total_price: total,
            payment_method:"cash"
        })
    });

    const data = await res.json();

console.log(data);

if (!data.success) {
    alert(data.message || "Booking failed");
    return;
}

window.location.href = "/confirmation/" + data.bookingId;
}


    // Online
    startRazorpay(total);

}

async function startRazorpay(amount) {

    const res = await fetch("/create-order", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "Authorization":"Bearer " + localStorage.getItem("access_token")
        },
        body: JSON.stringify({
            amount: amount
        })
    });

    const order = await res.json();

    var options = {
        key: "rzp_test_TCAPSTye93UTEk",
        amount: order.amount,
        currency: "INR",
        name: "Waver",
        description: "Salon Booking",
        order_id: order.id,

        handler: async function () {

    const res = await fetch("/create-booking",{
        method:"POST",
        headers:{
            "Content-Type":"application/json",
             "Authorization":"Bearer " + localStorage.getItem("access_token")
        },
        body:JSON.stringify({
            barber_id:"<%= barber.id %>",
            services: JSON.stringify(["<%= barber.service_name %>"]),
            total_price: amount,
            payment_method:"online"
        })
    });

    const data = await res.json();

console.log(data);

if (!data.success) {
    alert(data.message || "Booking failed");
    return;
}

window.location.href = "/confirmation/" + data.bookingId;

}
    };

    var rzp = new Razorpay(options);

    rzp.open();

}

    // ================= TIME SLOT SELECTION =================

let selectedTime = null;

const timeSlots = document.querySelectorAll(".time-slot");
const selectedTimeText = document.getElementById("selectedTime");

timeSlots.forEach(slot => {

    slot.addEventListener("click", function(){

        // booked slot ko select nahi karna
        if(this.classList.contains("booked")){
            return;
        }

        // pehle selected slot remove
        timeSlots.forEach(s => {
            s.classList.remove("selected");
        });

        // current slot select
        this.classList.add("selected");

        selectedTime = this.innerText;

        selectedTimeText.innerText =
            "Selected Time: " + selectedTime;

    });

});


</script>

</body>
</html>