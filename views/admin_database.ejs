<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Database Management</title>

<style>

body{
    margin:0;
    background:#0f172a;
    color:white;
    font-family:Arial;
    padding:40px;
}

h1{
    margin-bottom:30px;
}

.card{

    width:280px;
    background:#1e293b;

    padding:30px;

    border-radius:18px;

    border:1px solid #334155;

    transition:.3s;

}

.card:hover{

    transform:translateY(-6px);

    border-color:#3b82f6;

}

.number{

    font-size:45px;

    font-weight:bold;

    margin-top:10px;

    color:#3b82f6;

}

</style>

</head>

<body>

<h1>🗄 Database Management</h1>

<div class="card">

<h2>Total Customers</h2>

<div class="number">
    //-----------
    <div style="display:flex; gap:20px; flex-wrap:wrap;">

    <div class="card">

        <h2>Total Customers</h2>

        <div class="number">
            <%= customers %>
        </div>

    </div>

    <div class="card">

        <h2>Total Barbers</h2>

        <div class="number">
            <%= barbers %>
        </div>

    </div>

</div>
//------
<%= customers %>

</div>

</div>

</body>
</html>