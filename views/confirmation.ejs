<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Waiting | Waver</title>

    <style>
        body {
            margin: 0;
            background: #000;
            color: white;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        .box {
            margin-top: 120px;
        }

        .status {
            font-size: 22px;
            margin-top: 20px;
            color: #aaa;
        }

        .pending {
            color: orange;
        }

        .confirmed {
            color: lightgreen;
        }

        .loader {
            border: 4px solid #333;
            border-top: 4px solid white;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            margin: auto;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>

<body>

<div class="box">

    <h1>⏳ Waiting for Barber Confirmation</h1>
    <h2 >Waver</h2>

    <div class="loader"></div>

    <div class="status">
        Status: 
        <span id="status" class="pending"><%= booking.status %></span>
    </div>

</div>

<script>
setInterval(async () => {

    const res = await fetch("/booking-status/<%= booking.id %>");
    const data = await res.json();

    const statusEl = document.getElementById("status");

    statusEl.innerText = data.status;

    if (data.status === "confirmed") {
        statusEl.className = "confirmed";
        alert("🎉 Booking Confirmed!");
        window.location.href = "/";
    }

}, 3000);
</script>

</body>
</html>