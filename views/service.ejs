<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Services - Waver</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .marquee-container {
    width: 100%;
    background: #000000;
    color: #fff;
    padding: 15px 0;
    margin-top: 50px;
    border-top: 1px solid #333;
    border-bottom: 1px solid #333;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
}
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #0d0d0d;
            color: white;
        }

        /* NAVBAR */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 40px;
            background: #000;
            border-bottom: 1px solid #222;
        }

        nav h2 {
            color: white;
            font-size: 26px;
            letter-spacing: 2px;
        }

        nav ul {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        nav ul li a,
        nav ul li {
            color: white;
            text-decoration: none;
            cursor: pointer;
            font-size: 15px;
            opacity: 0.8;
        }

        nav ul li a:hover {
            opacity: 1;
        }

        /* CONTAINER */
        .service-container {
            max-width: 1100px;
            margin: 60px auto;
            padding: 20px;
        }

        .title {
            text-align: center;
            font-size: 36px;
            margin-bottom: 40px;
            font-weight: bold;
        }

        /* GRID */
        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        /* CARD */
        .card {
            background: #141414;
            border: 1px solid #222;
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-6px);
            border-color: #444;
        }

        .card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 15px;
        }

        .card h3 {
            margin: 10px 0;
            font-size: 20px;
        }

        .card p {
            color: #aaa;
            font-size: 14px;
        }

        .card button {
            margin-top: 15px;
            padding: 10px 18px;
            border: none;
            background: white;
            color: black;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }

        .card button:hover {
            background: #ddd;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav>
          <img src="/images/waver.png" alt="Waver Logo" class="logo">

        <div class="nav-right">

        <span class="profile-icon" onclick="toggleProfile()">
            👤
        </span>

    </div>
    </nav>

    <!-- SERVICES -->
    <div class="service-container">

        <h1 class="title">Our Barber Services ✂️</h1>

        <div class="service-grid">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1622296089863-eb7fc530daa8" alt="">
                <h3>Hair Cut</h3>
                <p>Sharp fade & modern styles</p>
                <a href="/barbers">
    <button>Book Now</button>
</a>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1621605815971-fbc98d665033" alt="">
                <h3>Beard Styling</h3>
                <p>Clean beard shaping & trimming</p>
                <button>Book Now</button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1559599101-f09722fb4948" alt="">
                <h3>Hair Spa</h3>
                <p>Relaxing premium hair care</p>
                <button>Book Now</button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1519415943484-9fa1873496d4" alt="">
                <h3>Shaving</h3>
                <p>Classic clean shave experience</p>
                <button>Book Now</button>
            </div>

        </div>
    </div>
    <!-- Moving Notice -->
<div class="marquee-container">
    <marquee behavior="scroll" direction="left" scrollamount="7">
        ✂️ ONLY HAIRCUT SERVICES ARE AVAILABLE • REST OF THE SERVICES WILL BE AVAILABLE SOON ✂️
    </marquee>
</div>
<script>

function toggleProfile(){

    document
    .getElementById("profilePanel")
    .classList
    .toggle("active");

}

</script>
<!-- Profile Sidebar -->
<div id="profilePanel" class="profile-panel">

    <div class="profile-header">
       <img
    id="profileAvatar"
    src="/images/default-user.png"
    class="profile-avatar-img"
>

<h2 id="userName">Welcome</h2>

<p id="userEmail">Loading...</p>
    </div>

    <hr>

    <a href="/booking-history">📜 Booking History</a>

    <a href="/term">📄 Terms & Conditions</a>

    <a href="/contactus">📞 Contact Us</a>

    <a href="/login">🚪 Logout</a>

</div>



