<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Waver Admin</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f4f4;
}

.wrapper{
    display:flex;
    min-height:100vh;
}

/* Sidebar */

.sidebar{
    width:240px;
    background:#111;
    color:white;
    padding:25px;
}

.sidebar h2{
    margin-bottom:40px;
    text-align:center;
}

.sidebar a{
    display:block;
    color:white;
    text-decoration:none;
    padding:15px;
    border-radius:8px;
    margin-bottom:10px;
    transition:.3s;
}

.sidebar a:hover{
    background:#333;
}

/* Main */

.main{
    flex:1;
    padding:30px;
}

.header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:30px;
}

.header h1{
    color:#111;
}

.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.card{
    background:white;
    border-radius:12px;
    padding:25px;
    box-shadow:0 10px 20px rgba(0,0,0,.08);
}

.card h2{
    font-size:30px;
    margin-top:15px;
}

.card p{
    color:#777;
}

.table-box{
    margin-top:40px;
    background:white;
    border-radius:12px;
    padding:20px;
    box-shadow:0 10px 20px rgba(0,0,0,.08);
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:15px;
    border-bottom:1px solid #eee;
    text-align:left;
}

th{
    background:#111;
    color:white;
}

.pending{
    color:orange;
    font-weight:bold;
}

.confirmed{
    color:green;
    font-weight:bold;
}

.rejected{
    color:red;
    font-weight:bold;
}

</style>

</head>
<body>

<div class="wrapper">

<div class="sidebar">

<h2>WAVER</h2>

<a href="/admin">📊 Dashboard</a>
<a href="/admin/users">👥 Users</a>
<a href="/admin/barbers">✂️ Barbers</a>
<a href="/admin/bookings">📅 Bookings</a>
<a href="/admin/revenue">💰 Revenue</a>
<a href="/admin/settings">⚙️ Settings</a>
</div>

<div class="main">

<div class="header">

<h1>Admin Dashboard</h1>

<h3>Welcome Admin 👋</h3>

</div>

<div class="cards">

<div class="card">
<p>Total Users</p>
<h2><%= totalUsers %></h2>
</div>

<div class="card">
<p>Total Barbers</p>
<h2><%= totalBarbers %></h2>
</div>

<div class="card">
<p>Total Bookings</p>
<h2><%= totalBookings %></h2>
</div>

<div class="card">
<p>Revenue</p>
<h2>₹ <%= revenue %></h2>
</div>

</div>

<div class="table-box">

<h2 style="margin-bottom:20px;">Recent Bookings</h2>

<table>

<tr>
<th>ID</th>
<th>Email</th>
<th>Payment</th>
<th>Amount</th>
<th>Status</th>
</tr>

<% bookings.forEach(booking=>{ %>

<tr>

<td><%= booking.id %></td>

<td><%= booking.user_email %></td>

<td><%= booking.payment_method %></td>

<td>₹ <%= booking.total_price %></td>

<td class="<%= booking.status %>">

<%= booking.status %>

</td>

</tr>

<% }) %>

</table>

</div>

</div>

</div>

</body>
</html>