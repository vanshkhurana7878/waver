<!DOCTYPE html>
<html>
<head>

<title>Users | Waver Admin</title>

<style>

body{
    background:#111;
    color:white;
    font-family:Arial;
    padding:30px;
}

table{
    width:100%;
    background:#1c1c1c;
    border-collapse:collapse;
}

th,td{
    padding:15px;
    border-bottom:1px solid #333;
    text-align:left;
}

th{
    background:black;
}

</style>

</head>


<body>


<h1>👥 Waver Users</h1>


<table>

<tr>

<th>ID</th>
<th>Email</th>

<th>Created</th>
<th>Status</th>
<th>Action</th>
</tr>


<% users.forEach(user=>{ %>


<tr>

<td>
<%= user.id %>
</td>


<td>
<%= user.email %>
</td>





<td>
<%= user.created_at || "-" %>
</td>

<td>

<% if(user.is_banned){ %>

<span style="color:red;font-weight:bold;">
Banned
</span>

<% }else{ %>

<span style="color:lime;font-weight:bold;">
Active
</span>

<% } %>

</td>

<td>

<% if(user.is_banned){ %>

<form action="/unban-user/<%= user.id %>" method="POST">

<button
style="background:#16a34a;color:white;padding:8px 15px;border:none;border-radius:6px;">
✅ Unban
</button>

</form>

<% } else { %>

<button
onclick="openBanModal('<%= user.id %>')"
style="background:#dc2626;color:white;padding:8px 15px;border:none;border-radius:6px;">
🚫 Ban
</button>

<% } %>

</td>

</tr>


<% }) %>


</table>
<div id="banModal" style="display:none;position:fixed;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,.75);">

<div style="width:400px;background:#1e293b;margin:120px auto;padding:30px;border-radius:15px;">

<h2>🚫 Ban User</h2>

<form action="/ban-user" method="POST">

<input type="hidden" name="id" id="userId">

<label>
<input type="radio" name="days" value="1" checked>
1 Day
</label>

<br><br>

<label>
<input type="radio" name="days" value="7">
7 Days
</label>

<br><br>

<label>
<input type="radio" name="days" value="30">
30 Days
</label>

<br><br>

<label>
<input type="radio" name="days" value="99999">
Permanent
</label>

<br><br>

<button type="submit">
Ban User
</button>

<button
type="button"
onclick="closeBanModal()"
style="background:red;margin-left:10px;"
>
Cancel
</button>

</form>

</div>

</div>
<script>

function openBanModal(id){

document.getElementById("banModal").style.display="block";

document.getElementById("userId").value=id;

}

function closeBanModal(){

document.getElementById("banModal").style.display="none";

}

</script>
</body>
</html>