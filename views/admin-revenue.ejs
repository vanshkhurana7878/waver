<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Revenue Dashboard</title>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<style>
body{
background:#111;
color:white;
font-family:Arial;
padding:30px;
}

.cards{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
margin-bottom:30px;
}

.card{
background:#1d1d1d;
padding:20px;
border-radius:10px;
text-align:center;
}

.chart{
background:#1d1d1d;
padding:20px;
border-radius:10px;
margin-bottom:30px;
}

table{
width:100%;
border-collapse:collapse;
background:#1d1d1d;
}

th,td{
padding:15px;
border-bottom:1px solid #333;
text-align:left;
}
</style>

</head>
<body>

<h1>Revenue Dashboard</h1>

<div class="cards">

<div class="card">
<h3>Total Revenue</h3>
<h2 id="revenue">₹0</h2>
</div>

<div class="card">
<h3>Total Bookings</h3>
<h2><%= bookings.length %></h2>
</div>

<div class="card">
<h3>Confirmed</h3>
<h2 id="confirmed">0</h2>
</div>

<div class="card">
<h3>Pending</h3>
<h2 id="pending">0</h2>
</div>

</div>

<div class="chart">
<div id="chart"></div>
</div>

<h2>Recent Bookings</h2>

<table>

<tr>
<th>User</th>
<th>Amount</th>
<th>Status</th>
</tr>

<% bookings.forEach(b=>{ %>

<tr>

<td><%= b.user_email %></td>

<td>₹<%= b.total_price %></td>

<td><%= b.status %></td>

</tr>

<% }) %>

</table>

<script>

const bookings="<%- JSON.stringify(bookings) %>";

let revenue=0;
let confirmed=0;
let pending=0;

const days={};

bookings.forEach(b=>{

if(b.status==="confirmed"){

confirmed++;

revenue+=Number(b.total_price);

const d=new Date(b.created_at).toLocaleDateString();

days[d]=(days[d]||0)+Number(b.total_price);

}

if(b.status==="pending"){

pending++;

}

});

document.getElementById("revenue").innerHTML="₹"+revenue;

document.getElementById("confirmed").innerHTML=confirmed;

document.getElementById("pending").innerHTML=pending;

new ApexCharts(document.querySelector("#chart"),{

chart:{
type:"line",
height:350
},

series:[{

name:"Revenue",

data:Object.values(days)

}],

xaxis:{

categories:Object.keys(days)

}

}).render();

</script>

</body>
</html>