<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Choose Your Barber | Waver</title>

    <style>
        body {
            margin: 0;
            background: #000;
            color: white;
            font-family: Arial, sans-serif;
        }

        nav {
            padding: 20px 40px;
            border-bottom: 1px solid #333;
        }

        nav h2 {
            margin: 0;
        }

        h1 {
            text-align: center;
            margin: 40px 0;
        }

        .container {
            width: 90%;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px,1fr));
            gap: 25px;
            padding-bottom: 40px;
        }

        .card {
            background: #111;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #333;
        }

        .card h2 {
            margin-bottom: 10px;
        }

        .card p {
            color: #ccc;
            margin: 8px 0;
        }

        button {
            width: 100%;
            padding: 12px;
            margin-top: 15px;
            border: none;
            background: white;
            color: black;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
        }
    </style>
</head>

<body>
<div class="logo-container">
    <img src="/images/logo.png" alt="Waver Logo" class="logo">
</div>
<nav>
      <img src="/images/waver.png" alt="Waver Logo" class="logo">
</nav>

<h1>Select Your Barber</h1>

<div class="container">

<% barbers.forEach(barber => { %>

<div class="card">

<h2><%= barber.Shop_name %></h2>

<p><b>Shop_name:</b> <%= barber.Shop_name %></p>

<p><b>City:</b> <%= barber.city %></p>

<p><b>email:</b> <%= barber.email %></p>

<p><b>phone:</b> <%= barber.phone %></p>

<a href="/pricing/<%= barber.id %>">
    <button>Select Barber</button>
</a>

</div>

<% }) %>

</div>

</body>
</html>