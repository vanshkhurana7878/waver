<!DOCTYPE html>
<html>
<head>

<meta charset="UTF-8">
<title>Barber Management</title>

<style>

body{
background:#111827;
color:white;
font-family:Arial;
padding:30px;
}

.top{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:25px;

}

button{

background:#2563eb;

color:white;

border:none;

padding:12px 20px;

border-radius:8px;

cursor:pointer;

font-size:15px;

}

button:hover{

background:#1d4ed8;

}

table{

width:100%;

border-collapse:collapse;

background:#1e293b;

border-radius:10px;

overflow:hidden;

}

th{

background:#0f172a;

padding:15px;

text-align:left;

}

td{

padding:15px;

border-bottom:1px solid #334155;

}

tr:hover{

background:#263548;

}

</style>

</head>

<body>

<div class="top">

<h1>💈 Barber Management</h1>

<button onclick="openModal()">
➕ Add Barber
</button>

</div>

<table>

<tr>

<th>ID</th>
<th>Name</th>
<th>Email</th>
<th>Phone</th>

</tr>

<% barbers.forEach(barber=>{ %>

<tr>

<td><%= barber.id %></td>

<td><%= barber.name %></td>

<td><%= barber.email %></td>

<td><%= barber.phone %></td>

</tr>

<% }) %>

</table>
<div id="modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.7);">

<div style="width:420px;background:#1e293b;margin:80px auto;padding:30px;border-radius:15px;">

<h2>Add Barber</h2>

<form action="/add-barber" method="POST">

<input
type="text"
name="name"
placeholder="Name"
required
style="width:100%;padding:12px;margin-top:15px;"
>

<input
type="email"
name="email"
placeholder="Email"
required
style="width:100%;padding:12px;margin-top:15px;"
>

<input
type="text"
name="phone"
placeholder="Phone"
required
style="width:100%;padding:12px;margin-top:15px;"
>

<button
type="submit"
style="margin-top:20px;width:100%;"
>
Save Barber
</button>

</form>

<button
onclick="closeModal()"
style="margin-top:10px;width:100%;background:red;"
>
Cancel
</button>

</div>

</div>
<script>

function openModal(){

document.getElementById("modal").style.display="block";

}

function closeModal(){

document.getElementById("modal").style.display="none";

}

</script>
</body>
</html>